+    <link data-trunk rel="rust" data-wasm-opt="z" />
+    <style>
+    :root, [data-theme="dark"] {
+      --bg-base: #1f1f1f;
+      --bg-panel: #292929;
+      --text-main: #eeeeee;
+      --text-muted: #b0b0b0;
+      --accent: #3b5bdb;
+      --border: #3a3a3a;
+      --aurora-gradient: linear-gradient(135deg, #4facfe 0%, #9b72cb 35%, #d96570 70%, #f3a183 100%);
+      --aurora-subtle-glow: linear-gradient(135deg, rgba(79, 172, 254, 0.15), rgba(155, 114, 203, 0.15), rgba(217, 101, 112, 0.15));
+    }
+    [data-theme="light"] {
+      --bg-base: #f0f0f0;
+      --bg-panel: #ffffff;
+      --text-main: #242424;
+      --text-muted: #616161;
+      --accent: #3b5bdb;
+      --border: #e1e1e1;
+    }
+    [data-theme="aurora"] {
+      --bg-base: #0b0d14;
+      --bg-panel: #131622;
+      --text-main: #e4e6eb;
+      --text-muted: #8b92a5;
+      --accent: #9b72cb;
+      --border: #272c40;
+      --aurora-gradient: linear-gradient(135deg, #4facfe 0%, #9b72cb 35%, #d96570 70%, #f3a183 100%);
+      --aurora-subtle-glow: linear-gradient(135deg, rgba(79, 172, 254, 0.15), rgba(155, 114, 203, 0.15), rgba(217, 101, 112, 0.15));
+    }
+      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg-base, #f1f1f3); }
+      canvas { width: 100%; height: 100%; display: block; outline: none; }
+      @media (prefers-color-scheme: dark) { html, body { background: #19191c; } }
+    </style>
+    <script>
+    (function() {
+      try {
+        var theme = localStorage.getItem("artcraft_theme") || "dark";
+        document.documentElement.setAttribute("data-theme", theme);
+      } catch (e) {}
+    })();
+  </script>
+</head>
+  <body>
+    <canvas id="pdfcraft"></canvas>
+  </body>
+</html>
